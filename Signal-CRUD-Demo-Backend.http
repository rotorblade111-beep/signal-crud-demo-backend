@Signal_CRUD_Demo_Backend_HostAddress = http://localhost:5093
@accessToken = paste-access-token-here

### Get all posts
GET {{Signal_CRUD_Demo_Backend_HostAddress}}/posts
Accept: application/json

### Get the first 10 posts
GET {{Signal_CRUD_Demo_Backend_HostAddress}}/posts?offset=0&limit=10
Accept: application/json

### Get posts 11 through 20
GET {{Signal_CRUD_Demo_Backend_HostAddress}}/posts?offset=10&limit=10
Accept: application/json

### Invalid range returns a validation problem
GET {{Signal_CRUD_Demo_Backend_HostAddress}}/posts?offset=-1&limit=10
Accept: application/json

### Get a post
GET {{Signal_CRUD_Demo_Backend_HostAddress}}/posts/1
Accept: application/json

### Create a post
POST {{Signal_CRUD_Demo_Backend_HostAddress}}/posts
Content-Type: application/json

{
  "title": "A new post",
  "body": "This post is stored in SQLite."
}

### Update a post
PUT {{Signal_CRUD_Demo_Backend_HostAddress}}/posts/1
Content-Type: application/json

{
  "title": "Updated post",
  "body": "Updated content persisted in SQLite."
}

### Delete a post
DELETE {{Signal_CRUD_Demo_Backend_HostAddress}}/posts/1

### Missing post returns 404
GET {{Signal_CRUD_Demo_Backend_HostAddress}}/posts/999999

### Sign up
POST {{Signal_CRUD_Demo_Backend_HostAddress}}/auth/sign-up
Content-Type: application/json

{
  "email": "new.user@example.com",
  "password": "SecureTest123!",
  "dateOfBirth": "1998-06-15"
}

### Log in with the seeded development user
POST {{Signal_CRUD_Demo_Backend_HostAddress}}/auth/login
Content-Type: application/json

{
  "username": "alice@example.com",
  "password": "PosthubTest123!"
}

### Invalid login returns 401
POST {{Signal_CRUD_Demo_Backend_HostAddress}}/auth/login
Content-Type: application/json

{
  "username": "alice@example.com",
  "password": "wrong-password"
}

### Reset a password
POST {{Signal_CRUD_Demo_Backend_HostAddress}}/auth/reset-password
Content-Type: application/json

{
  "email": "new.user@example.com",
  "newPassword": "AnotherSecure123!"
}

### Reset a password for an unknown email returns 404
POST {{Signal_CRUD_Demo_Backend_HostAddress}}/auth/reset-password
Content-Type: application/json

{
  "email": "missing.user@example.com",
  "newPassword": "AnotherSecure123!"
}

### Get the authenticated user's profile
GET {{Signal_CRUD_Demo_Backend_HostAddress}}/profile
Authorization: Bearer {{accessToken}}

### Update personal information
PUT {{Signal_CRUD_Demo_Backend_HostAddress}}/profile/personal-information
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "firstName": "Alice",
  "lastName": "Example",
  "dateOfBirth": "1995-04-12",
  "address": "123 Example Street",
  "country": "United States"
}

### Update account email
PUT {{Signal_CRUD_Demo_Backend_HostAddress}}/profile/email
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "email": "alice.updated@example.com"
}

### Change authenticated account password
PUT {{Signal_CRUD_Demo_Backend_HostAddress}}/profile/password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "newPassword": "AnotherSecure123!"
}

### Duplicate email returns 409
PUT {{Signal_CRUD_Demo_Backend_HostAddress}}/profile/email
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "email": "bob@example.com"
}

### Invalid personal information returns 400
PUT {{Signal_CRUD_Demo_Backend_HostAddress}}/profile/personal-information
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "dateOfBirth": "2099-01-01"
}
